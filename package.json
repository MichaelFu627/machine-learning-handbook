{
  "name": "machine-learning-handbook",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/engine.test.ts",
    "test:e2e": "playwright test",
    "dev:web": "next dev --hostname 127.0.0.1",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"content/**/*.{json,mdx}\" \"tests/**/*.ts\" \"scripts/*.{mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"content/**/*.{json,mdx}\" \"tests/**/*.ts\" \"scripts/*.{mjs,ts}\""
  },
  "dependencies": {
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
